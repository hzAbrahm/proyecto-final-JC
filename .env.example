# Duplica este archivo como .env y completa los valores desde MongoDB Atlas.
# No publiques el archivo .env ni compartas su URI.
MONGODB_URI=mongodb+srv://<usuario>:<contrasena>@<cluster-host>/
MONGODB_DATABASE=Calles-Dulces
PORT=3003
NODE_ENV=development

# Dominios autorizados para consumir la API (separados por coma).
FRONTEND_ORIGINS=https://hzabrahm.github.io
